# Replace placeholders only in the server's private /etc/slack-auto-mention/env.
SLACK_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
SLACK_SIGNING_SECRET=REPLACE_WITH_SIGNING_SECRET
SLACK_TEAM_ID=REPLACE_WITH_VERIFIED_WORKSPACE_ID
SLACK_BOT_USER_ID=REPLACE_WITH_VERIFIED_BOT_USER_ID
SLACK_CHANNEL_IDS=REPLACE_WITH_COMMA_SEPARATED_VERIFIED_CHANNEL_IDS
SLACK_CHANNEL_MODE=explicit
# all_joined permits ordinary channels that the bot already belongs to.
# Group DMs must still be explicitly listed; 1:1 DMs remain excluded.
SLACK_GROUP_DM_IDS=
# Optional shared-channel subset of SLACK_CHANNEL_IDS, in either channel mode.
# Empty by default; requires separate verified access/activation approval.
SLACK_SHARED_CHANNEL_IDS=
SLACK_MEMBER_IDS=REPLACE_WITH_COMMA_SEPARATED_VERIFIED_USER_IDS
ALLOWLIST_VERIFIED=false
BOT_ENABLED=false
DATABASE_PATH=/var/lib/slack-auto-mention/events.sqlite3
PORT=8765
# Opt-in, exact verified routes. Credentials remain in the existing host private file.
# See deploy/DISCORD-MIRROR.md before enabling. No history/backfill.
DISCORD_MIRROR_ENABLED=false
DISCORD_MIRROR_CONFIG={"guild":"111111111111111111","category":"222222222222222222","application":"333333333333333333","bot_user":"444444444444444444","since":1700000000,"routes":{"C00000001":{"name":"general","discord":"555555555555555555"}}}
