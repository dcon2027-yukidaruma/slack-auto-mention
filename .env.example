# Replace placeholders only in the server's private /etc/slack-auto-mention/env.
SLACK_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
SLACK_SIGNING_SECRET=REPLACE_WITH_SIGNING_SECRET
SLACK_TEAM_ID=REPLACE_WITH_VERIFIED_WORKSPACE_ID
SLACK_BOT_USER_ID=REPLACE_WITH_VERIFIED_BOT_USER_ID
SLACK_CHANNEL_IDS=REPLACE_WITH_COMMA_SEPARATED_VERIFIED_CHANNEL_IDS
SLACK_CHANNEL_MODE=explicit
# all_joined permits ordinary channels that the bot already belongs to.
# Group DMs must still be explicitly listed; 1:1 DMs and Slack Connect are excluded.
SLACK_GROUP_DM_IDS=
SLACK_MEMBER_IDS=REPLACE_WITH_COMMA_SEPARATED_VERIFIED_USER_IDS
ALLOWLIST_VERIFIED=false
BOT_ENABLED=false
DATABASE_PATH=/var/lib/slack-auto-mention/events.sqlite3
PORT=8765
